# Inbox.eu Business administrator API key.
INBOXEU_API_KEY=

# Use read-only for lookups or full for all supported operations.
INBOXEU_MODE=read-only

# Optional tool defaults. Leave a value blank to supply it at call time.
# Shared domain (domainName, hostName, hostname), mailbox ID and administrator ID.
INBOXEU_DOMAIN_NAME=
INBOXEU_USER_ID=
INBOXEU_DOMAIN_ADMIN=

# Optional domains for the same API key. Choose one JSON format.
# Domains only: INBOXEU_DOMAINS='["example.org","example.net"]'
# Mailbox IDs by domain: INBOXEU_DOMAINS='{"example.org":["00123","00456"],"example.net":["00789"]}'
INBOXEU_DOMAINS=

# inboxeu_list_invoices. LIMIT and OFFSET are integers. UNEXPIRED is a string.
INBOXEU_LIST_INVOICES_LIMIT=
INBOXEU_LIST_INVOICES_OFFSET=
INBOXEU_LIST_INVOICES_UNEXPIRED=
INBOXEU_LIST_INVOICES_ORDER_COLUMN=
INBOXEU_LIST_INVOICES_ORDER_DIRECTION=

# inboxeu_check_admin_email
INBOXEU_CHECK_ADMIN_EMAIL=

# inboxeu_create_admin. DOMAIN_NAME is a JSON object. IS_EMAIL_VERIFIED is a boolean.
INBOXEU_CREATE_ADMIN_EMAIL=
INBOXEU_CREATE_ADMIN_LANGUAGE=
INBOXEU_CREATE_ADMIN_FIRST_NAME=
INBOXEU_CREATE_ADMIN_LAST_NAME=
INBOXEU_CREATE_ADMIN_DOMAIN_NAME=
INBOXEU_CREATE_ADMIN_EU_REF_ID=
INBOXEU_CREATE_ADMIN_PASSWORD=
INBOXEU_CREATE_ADMIN_IS_EMAIL_VERIFIED=

# inboxeu_update_profile. PREFS is a JSON object. TOS accepts true.
INBOXEU_UPDATE_PROFILE_FIRST_NAME=
INBOXEU_UPDATE_PROFILE_LAST_NAME=
INBOXEU_UPDATE_PROFILE_LANGUAGE=
INBOXEU_UPDATE_PROFILE_PREFS=
INBOXEU_UPDATE_PROFILE_PLAIN_PASSWORD=
INBOXEU_UPDATE_PROFILE_TOS=

# inboxeu_invite_admin also uses INBOXEU_DOMAIN_NAME for hostname.
INBOXEU_INVITE_ADMIN_EMAIL=
INBOXEU_INVITE_ADMIN_USER=

# Mailbox request bodies are JSON objects, except CREATE_MAILBOXES_BODY (a JSON array).
INBOXEU_UPDATE_MAILBOX_BODY=
INBOXEU_CREATE_MAILBOXES_BODY=
INBOXEU_CREATE_IMPERSONATION_TOKEN_BODY=
INBOXEU_VALIDATE_IMPERSONATION_TOKEN_BODY=
INBOXEU_IMPERSONATION_TOKEN=
INBOXEU_SEND_MAILBOX_DETAILS_BODY=
